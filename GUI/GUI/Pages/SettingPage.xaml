<Page x:Class="GUI.SettingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:toolkit="using:CommunityToolkit.WinUI.Controls"
      xmlns:conv="using:GUI.Converters">

    <Page.Resources>
        <conv:BoolToCardCornerConverter x:Key="ScLanguageBoolToCardCorner"
                                        TrueCorner="12,12,0,0"
                                        FalseCorner="12"/>
        <Style TargetType="toolkit:SettingsCard">
            <Setter Property="CornerRadius" Value="12"/>
        </Style>
    </Page.Resources>


    <ScrollViewer Padding="24">
        <StackPanel Spacing="16">
            <!-- 应用语言 -->
            <StackPanel>
                <toolkit:SettingsCard x:Name="ScLanguage"
                                      Header="应用语言"
                                      Description="修改界面显示语言"
                                      CornerRadius="{x:Bind ViewModel.NeedRestartAfterLanguageChange,
                                                            Mode=OneWay,
                                                            Converter={StaticResource ScLanguageBoolToCardCorner}}">
                    <StackPanel>
                        <ComboBox x:Name="CbLanguage"
                                  ItemsSource="{x:Bind ViewModel.AvailableLanguages}"
                                  SelectedItem="{x:Bind ViewModel.SelectedLanguage, Mode=TwoWay}"
                                  PlaceholderText="请选择语言"/>
                    </StackPanel>
                </toolkit:SettingsCard>
                <muxc:InfoBar x:Name="InfoBarLangRestart"
                              Severity="Informational"
                              IsOpen="{x:Bind ViewModel.NeedRestartAfterLanguageChange, Mode=OneWay}"
                              IsClosable="False"
                              Margin="0,-2,0,0"
                              CornerRadius="0,0,12,12"
                              Background="#0DFFFFFF">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition MinWidth="200"/>
                            <ColumnDefinition MinWidth="70"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="语言修改需要重启应用后生效。"
                                   Grid.Column="0"
                                   HorizontalAlignment="Left"
                                   Margin="0,6,0,0"/>
                        <Button Content="立即重启"
                                Grid.Column="1"
                                HorizontalAlignment="Right"
                                Margin="0,0,12,0"/>
                    </Grid>
                </muxc:InfoBar>
            </StackPanel>

            <!-- CLI程序路径 -->
            <toolkit:SettingsCard Header="CLI可执行文件路径"
                               Description="MCNbtCli.exe 的完整路径">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <TextBox x:Name="TbCliPath"
                             Text="{x:Bind ViewModel.CliExecutablePath, Mode=TwoWay}"
                             MinWidth="320"/>
                    <Button Content="浏览" Click="BtnBrowseCli_Click"/>
                </StackPanel>
            </toolkit:SettingsCard>

            <!-- 默认NBT版本 -->
            <toolkit:SettingsCard Header="默认NBT版本"
                               Description="打开NBT文件使用的默认端序模式">
                <ComboBox x:Name="CbDefaultEdition"
                          ItemsSource="{x:Bind ViewModel.EditionOptions}"
                          SelectedItem="{x:Bind ViewModel.DefaultNbtEdition, Mode=TwoWay}"/>
            </toolkit:SettingsCard>

            <!-- 重置全部设置 -->
            <Button x:Name="BtnResetSettings"
                    Content="重置全部设置"
                    Click="BtnResetSettings_Click"
                    HorizontalAlignment="Left"/>
        </StackPanel>
    </ScrollViewer>
</Page>
