<Page x:Class="GUI.EditPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:muxc="using:Microsoft.UI.Xaml.Controls"
      xmlns:models="using:GUI.Models"
      xmlns:conv="using:GUI.Converters">

    <Page.Resources>
        <ResourceDictionary>
            <conv:StringNotEmptyToVisibility x:Key="StringNotEmptyToVisibility"/>
            <conv:StringEmptyToVisibility x:Key="StringEmptyToVisibility"/>
        </ResourceDictionary>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="360"/>
        </Grid.ColumnDefinitions>

        <!-- 顶部工具栏 -->
        <StackPanel Grid.Row="0" Grid.ColumnSpan="2"
                    Orientation="Horizontal"
                    Spacing="6">
            <Button x:Name="BtnAddTag"
                HorizontalAlignment="Right"
                Click="BtnAddTag_Click"
                ToolTipService.ToolTip="新建NBT标签">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                          Glyph="&#xE710;"/>
                    <TextBlock Text="新建标签" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnSave"
                    HorizontalAlignment="Right"
                    Click="BtnSave_Click"
                    ToolTipService.ToolTip="保存当前文件">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE74E;"/>
                    <TextBlock Text="保存" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
            <Button x:Name="BtnSaveAs"
                    HorizontalAlignment="Right"
                    Click="BtnSaveAs_Click"
                    ToolTipService.ToolTip="另存为">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}"
                              Glyph="&#xE74F;"/>
                    <TextBlock Text="另存为…" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>

        <muxc:TreeView x:Name="NbtJsonTreeView"
               Grid.Row="1" Grid.Column="0"
               Margin="0,8,8,0"
               ItemsSource="{x:Bind TreeItems, Mode=OneWay}"
               SelectionMode="Single"
               SelectionChanged="TreeView_OnSelectionChanged">
            <muxc:TreeView.ItemTemplate>
                <DataTemplate x:DataType="models:JsonTreeItem">
                    <muxc:TreeViewItem ItemsSource="{x:Bind Children}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <!-- 普通节点：显示Name -->
                            <TextBlock Text="{x:Bind Name}" Width="160" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind Name, Converter={StaticResource StringNotEmptyToVisibility}}"/>
                            <!-- List内部子项：显示值预览 -->
                            <TextBlock Text="{x:Bind ListItemPreview}" Width="160" TextTrimming="CharacterEllipsis"
                                       Visibility="{x:Bind Name, Converter={StaticResource StringEmptyToVisibility}}"/>

                            <TextBlock Text="{x:Bind Type}" Foreground="#888888" Width="80"/>

                            <!-- 节点后缀，": 内容" -->
                            <TextBlock Text="{x:Bind NodeSuffix}" Foreground="Gray"/>
                        </StackPanel>
                    </muxc:TreeViewItem>
                </DataTemplate>
            </muxc:TreeView.ItemTemplate>
        </muxc:TreeView>

        <!-- 右侧属性面板 -->
        <Border Grid.Row="1" Grid.Column="1"
                Margin="8,8,0,0"
                Padding="12"
                BorderThickness="1"
                CornerRadius="4">
            <ScrollViewer>
                <StackPanel x:Name="PropertyPanel">
                    <TextBlock Text="键" Margin="0,0,0,4"/>
                    <TextBox x:Name="TxtTagKey"
                             PlaceholderText="修改标签名称"
                             LostFocus="TxtTagKey_LostFocus"/>

                    <TextBlock Text="NBT标签类型" Margin="0,12,0,4"/>
                    <ComboBox x:Name="CmbTagType" IsEnabled="False"/>

                    <TextBlock Text="值" Margin="0,12,0,4"/>
                    <RichEditBox x:Name="HostValueEditor"/>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</Page>
